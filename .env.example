# =============================================================================
# AI 3D Studio - environment template
# Copy to .env.local (web) and services/*/.env (backend). Never commit real values.
# =============================================================================

# --- Branding (change the product name without touching code) -----------------
NEXT_PUBLIC_PRODUCT_NAME="AI 3D Studio"
NEXT_PUBLIC_PRODUCT_TAGLINE="Describe a scene. Direct it like a film."
NEXT_PUBLIC_SUPPORT_EMAIL="support@example.com"

# --- Web (Next.js) ------------------------------------------------------------
# Public URL of the FastAPI backend (no trailing slash).
NEXT_PUBLIC_API_BASE_URL="http://localhost:8000"
# Supabase project (browser-safe values only: anon key is public by design).
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Feature flags (see docs/architecture/feature-flags.md)
NEXT_PUBLIC_ENABLE_GPU_JOBS="false"
NEXT_PUBLIC_ENABLE_SEGMENTATION="false"

# --- API service (FastAPI) ----------------------------------------------------
ENVIRONMENT="development"            # development | staging | production
API_HOST="0.0.0.0"
API_PORT="8000"
LOG_LEVEL="INFO"
# Comma separated list of allowed browser origins.
CORS_ORIGINS="http://localhost:3000"
# Comma separated list of hosts trusted for X-Forwarded-* headers.
FORWARDED_ALLOW_IPS="127.0.0.1"

# --- Database (Supabase Postgres) --------------------------------------------
# Server-side only. Use the *pooled* connection string in production.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai3dstudio"
DATABASE_POOL_MIN="1"
DATABASE_POOL_MAX="10"

# --- Supabase service credentials (server-side only, NEVER expose) ------------
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_JWT_SECRET=""
SUPABASE_JWKS_URL=""                 # preferred: https://<ref>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_STORAGE_BUCKET="project-assets"

# --- Auth --------------------------------------------------------------------
# Set to "true" ONLY in local development. Disables signature verification and
# lets the API mint a dev principal. Refused when ENVIRONMENT=production.
ALLOW_DEV_AUTH="true"
DEV_AUTH_USER_ID="00000000-0000-4000-8000-000000000001"

# --- Redis / job queue -------------------------------------------------------
REDIS_URL="redis://localhost:6379/0"
JOB_QUEUE_NAMESPACE="ai3d"

# --- Blender render worker ---------------------------------------------------
BLENDER_BIN="/usr/bin/blender"
BLENDER_VERSION_EXPECTED="5.2"           # 5.2 LTS is the production pin; 5.3 became stable 2026-11-10
RENDER_WORK_DIR="/tmp/ai3d-renders"
RENDER_MAX_CONCURRENCY="1"
ENABLE_CYCLES_GPU="false"
API_BASE_URL="http://localhost:8000"  # used by workers to report progress
# Shared secret for worker -> API callbacks (POST /api/v1/jobs/{id}/progress).
# Generate with: openssl rand -hex 32
SERVICE_TOKEN=""

# --- AI model providers ------------------------------------------------------
# "deterministic" = rule-based local planner (labelled fallback, no network).
# "openai-compatible" = any hosted LLM exposing /v1/chat/completions.
PLANNER_PROVIDER="deterministic"
PLANNER_MODEL=""
PLANNER_BASE_URL=""
PLANNER_API_KEY=""
# Optional adapter endpoints. Leave blank to keep the adapter in "unavailable"
# state: the UI then shows the feature as disabled instead of faking output.
ADAPTER_HUNYUAN3D_URL=""
ADAPTER_SAM2_URL=""
ADAPTER_TEXTURE_URL=""
ADAPTER_MOTION_URL=""
ADAPTER_TTS_URL=""

# --- Limits ------------------------------------------------------------------
MAX_SCENE_OBJECTS="5000"
MAX_UPLOAD_MB="512"
RATE_LIMIT_PER_MINUTE="120"
JOB_TIMEOUT_SECONDS="3600"

# --- Observability -----------------------------------------------------------
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
