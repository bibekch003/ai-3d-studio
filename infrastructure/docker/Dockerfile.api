# API service. Slim, non-root, no build toolchain in the final layer.
FROM python:3.12-slim AS base

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

RUN apt-get update \
 && apt-get install -y --no-install-recommends curl \
 && rm -rf /var/lib/apt/lists/*

COPY services/api/pyproject.toml ./services/api/pyproject.toml
COPY services/ai-orchestrator/pyproject.toml ./services/ai-orchestrator/pyproject.toml

RUN pip install --upgrade pip \
 && pip install "./services/api[postgres]" \
 && pip install ./services/ai-orchestrator

COPY services/api/app ./services/api/app
COPY services/ai-orchestrator/ai_orchestrator ./services/ai-orchestrator/ai_orchestrator

RUN useradd --create-home --uid 10001 appuser \
 && chown -R appuser:appuser /app
USER appuser

WORKDIR /app/services/api
EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD curl -fsS http://localhost:8000/healthz || exit 1

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--proxy-headers"]
